{
  "name": "firststep-careers-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "demo": "tsx scripts/demo.ts",
    "test:ui": "playwright test",
    "pretest:ui": "npm run build"
  },
  "dependencies": {
    "@tiny-fish/sdk": "0.8.0",
    "dotenv": "18.0.7",
    "ipaddr.js": "2.5.0",
    "playwright-core": "1.56.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
